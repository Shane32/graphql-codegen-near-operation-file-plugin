{
  "name": "dummy",
  "version": "0.2.2",
  "description": "",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "postinstall": "husky",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "node tools/cleanup cjs && tsc -p config/tsconfig.cjs.json && copyfiles \"src/**/*\" dist/cjs -e \"**/*.ts\" -e \"**/*.tsx\" -e \"**/*.js\" -e \"**/*.jsx\" -e \"**/*.test.*\" -u 1",
    "build:esm": "node tools/cleanup esm && tsc -p config/tsconfig.esm.json && copyfiles \"src/**/*\" dist/esm -e \"**/*.ts\" -e \"**/*.tsx\" -e \"**/*.js\" -e \"**/*.jsx\" -e \"**/*.test.*\" -u 1",
    "build:types": "node tools/cleanup types && tsc -p config/tsconfig.types.json",
    "clean": "node tools/cleanup",
    "package": "npm run build && npm pack",
    "test": "",
    "prettier": "prettier -w \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --end-of-line auto",
    "test-prettier": "prettier -c \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --end-of-line auto",
    "lint": "eslint src"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "example",
    "typescript",
    "npm",
    "package",
    "sample",
    "boilerplate",
    "starter",
    "demo",
    "cjs",
    "esm"
  ],
  "author": "Shane Krueger <shane@acdmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dummy/dummy",
  "repository": {
    "type": "git",
    "url": "git@github.com:dummy/dummy.git"
  },
  "bugs": {
    "url": "https://github.com/dummy/dummy/issues"
  },
  "peerDependencies": {
    "graphql": "^0.8.0 || ^0.9.0 || ^0.10.0 || ^0.11.0 || ^0.12.0 || ^0.13.0 || ^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "@graphql-tools/apollo-engine-loader": "^9.0.4",
    "@types/node": "^22.20.5",
    "@types/pretty": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "pretty": "^2.0.0",
    "pretty-quick": "^4.2.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  }
}
